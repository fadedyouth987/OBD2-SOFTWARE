<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4 MSI for the RootCause OBD edge daemon and the 32-bit J2534 bridge (Task 5.1).
  Built by .github/workflows/package.yml:

    wix build edge-daemon.wxs -arch x64 -d Version=0.1.0 \
      -d DaemonExe=target\x86_64-pc-windows-msvc\release\edge-daemon.exe \
      -d BridgeExe=target\i686-pc-windows-msvc\release\j2534-bridge.exe -o edge-daemon.msi

  The daemon runs as the RootCauseEdgeDaemon service (`edge-daemon service`) under its
  own virtual account, NT SERVICE\RootCauseEdgeDaemon, and listens on loopback only.
  Its allowed web origin and data folder are in the service's own Environment value,
  which Windows reads at each start. The service manager restarts it after a failure.

  Data folder C:\ProgramData\RootCauseOBD: SYSTEM, Administrators and the service only
  (leases, audit log, logs). Its pairing\ subfolder is the one place members of the
  local group "RootCause Technicians" may write, so they can run `edge-daemon pair`.
  The group is created at install and kept on uninstall (so upgrades keep members).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="RootCause OBD Edge Daemon" Manufacturer="RootCause OBD Australia" Version="$(var.Version)"
           UpgradeCode="7E9E6E2A-4B54-4B77-A4B3-1F492C7B0011" Scope="perMachine" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of RootCause OBD Edge Daemon is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RootCauseOBD">
        <Component Id="EdgeDaemonBin" Guid="2B61F58C-1E23-41C1-98E2-370F4F320021">
          <File Id="EdgeDaemonExe" Name="edge-daemon.exe" Source="$(var.DaemonExe)" KeyPath="yes" />
          <ServiceInstall Id="EdgeDaemonSvc" Name="RootCauseEdgeDaemon" DisplayName="RootCause OBD Edge Daemon"
                          Description="Local service between the vehicle adapter and the RootCause web app (loopback only)."
                          Arguments="service" Account="NT SERVICE\RootCauseEdgeDaemon"
                          Start="auto" Type="ownProcess" ErrorControl="normal" />
          <ServiceControl Id="EdgeDaemonCtrl" Name="RootCauseEdgeDaemon" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          <!-- Virtual accounts need an unrestricted service SID; a failure exit counts as a failure. -->
          <ServiceConfig ServiceName="RootCauseEdgeDaemon" ServiceSid="unrestricted" FailureActionsWhenNonFatalExitCodes="yes"
                         OnInstall="yes" OnReinstall="yes" />
          <!-- Like the Linux unit's Restart=on-failure: restart after a crash or a failed start. -->
          <ServiceConfigFailureActions ServiceName="RootCauseEdgeDaemon" OnInstall="yes" OnReinstall="yes" ResetPeriod="86400">
            <Failure Action="restart" Delay="5000" />
            <Failure Action="restart" Delay="15000" />
            <Failure Action="restart" Delay="60000" />
          </ServiceConfigFailureActions>
          <!-- Read by the service manager each time the service starts. Production origin only. -->
          <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\RootCauseEdgeDaemon" Name="Environment" Type="multiString">
            <MultiStringValue Value="EDGE_ALLOWED_ORIGINS=https://app.rootcauseobd.com.au" />
            <MultiStringValue Value="EDGE_PORT=8765" />
            <MultiStringValue Value="EDGE_DATA_DIR=[DATAFOLDER]" />
          </RegistryValue>
        </Component>
        <Component Id="J2534BridgeBin" Guid="9A11E44D-3F22-48AA-B321-889C4D120032">
          <File Id="J2534BridgeExe" Name="j2534-bridge.exe" Source="$(var.BridgeExe)" KeyPath="yes" />
        </Component>
        <!-- `edge-daemon pair` from any new terminal, against the service's data folder. -->
        <Component Id="CliEnvironment" Guid="5C0E8B6A-0F3D-4E21-9B7A-6D2C1A4E8F10">
          <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
          <Environment Id="DataDirEntry" Name="EDGE_DATA_DIR" Value="[DATAFOLDER]" Action="set" System="yes" Permanent="no" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\RootCauseOBD\EdgeDaemon" Name="CliEnvironment" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="RootCauseOBD">
        <!--
          Leases, the audit log and logs: full control for SYSTEM, Administrators and
          the service's own SID (NT SERVICE\RootCauseEdgeDaemon = S-1-5-80-1551206977-3513691835-2365400430-3250671907-261597296), nobody else.
        -->
        <Component Id="DataFolder" Guid="D3A0E4B1-6C2F-4B7E-8A19-2F5D7C9E0B44">
          <CreateFolder>
            <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;FA;;;S-1-5-80-1551206977-3513691835-2365400430-3250671907-261597296)" />
          </CreateFolder>
          <RegistryValue Root="HKLM" Key="SOFTWARE\RootCauseOBD\EdgeDaemon" Name="DataFolder" Type="string" Value="[DATAFOLDER]" KeyPath="yes" />
        </Component>
        <Directory Id="PAIRINGFOLDER" Name="pairing">
          <!-- Pairing codes only. GrantTechniciansPairing adds "RootCause Technicians": Modify. -->
          <Component Id="PairingFolder" Guid="8B2D6F1E-4A7C-4E39-9D05-3C1B7A2E6F58">
            <CreateFolder>
              <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;FA;;;S-1-5-80-1551206977-3513691835-2365400430-3250671907-261597296)" />
            </CreateFolder>
            <RegistryValue Root="HKLM" Key="SOFTWARE\RootCauseOBD\EdgeDaemon" Name="PairingFolder" Type="string" Value="[PAIRINGFOLDER]" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- The technicians group, then its Modify right on pairing\ only. -->
    <CustomAction Id="CreateTechniciansGroup" Directory="DATAFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]net.exe&quot; localgroup &quot;RootCause Technicians&quot; /add /comment:&quot;May create RootCause edge daemon pairing codes&quot;" />
    <CustomAction Id="GrantTechniciansPairing" Directory="DATAFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[System64Folder]icacls.exe&quot; &quot;[PAIRINGFOLDER].&quot; /grant &quot;RootCause Technicians:(OI)(CI)M&quot;" />
    <InstallExecuteSequence>
      <Custom Action="CreateTechniciansGroup" After="CreateFolders" Condition="NOT REMOVE" />
      <Custom Action="GrantTechniciansPairing" After="CreateTechniciansGroup" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Edge daemon and J2534 bridge" Level="1">
      <ComponentRef Id="EdgeDaemonBin" />
      <ComponentRef Id="J2534BridgeBin" />
      <ComponentRef Id="CliEnvironment" />
      <ComponentRef Id="DataFolder" />
      <ComponentRef Id="PairingFolder" />
    </Feature>
  </Package>
</Wix>
