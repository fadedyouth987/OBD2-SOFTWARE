# Copy to .env for local development. Never commit .env.

# --- Data residency (Task 0.1): enforced at service startup ---
AWS_REGION=ap-southeast-2
DATA_RESIDENCY_ENFORCE=true

# --- Signing and hashing keys: secret-manager references, never key material ---
LEASE_SIGNING_KEY_REF=secretsmanager://ap-southeast-2/obd2-diag/lease-signing-key
LEASE_SIGNING_KID=dev-2026-11
VIN_HMAC_KEY_REF=secretsmanager://ap-southeast-2/obd2-diag/vin-hmac-key
# Local development only: point the reference at an env var instead.
# VIN_HMAC_KEY_REF=env://VIN_HMAC_KEY
# VIN_HMAC_KEY=dev-only-vin-hmac-key-change-me

# --- Edge daemon WebSocket origin allowlist (comma-separated) ---
# Production: the deployed web origin only. Dev adds http://localhost:3000.
EDGE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# --- AI ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Local infrastructure (dev defaults, match infra/docker-compose.yml) ---
POSTGRES_USER=diag
POSTGRES_PASSWORD=diag
POSTGRES_DB=diag
POSTGRES_PORT=5432
# The API uses the non-owner role (RLS applies); migrations use the owner.
DATABASE_URL=postgresql+psycopg://diag_app:diag_app@localhost:5432/diag
MIGRATION_DATABASE_URL=postgresql+psycopg://diag:diag@localhost:5432/diag
APP_DB_PASSWORD=diag_app
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=diag-dev-password
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=automotive-traces-au
S3_ACCESS_KEY_ID=diagdev
S3_SECRET_ACCESS_KEY=diagdevsecret

# --- Cloud API signing (required; fail closed if unset) ---
# 32-byte Ed25519 seed as 64 hex characters. Generate locally:
#   python3 -c "import os; print(os.urandom(32).hex())"
# Never commit the value. There is no hardcoded development seed.
CLOUD_SIGNING_PRIVATE_KEY_HEX=

# Local-only session minting (POST /api/v1/auth/dev-session and /dev-mark-aasra).
# Must stay false in any shared or production environment.
AUTH_ALLOW_DEV_LOGIN=false

# Stripe webhook signing secret (whsec_...). Required; there is no default.
# The official stripe.Webhook.construct_event verifier is used.
STRIPE_WEBHOOK_SECRET=

