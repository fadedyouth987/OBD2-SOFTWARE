{
  "$schema": "./module_catalog.schema.json",
  "catalog_version": "1.0.0",
  "probe": {
    "service": "0x3E",
    "payload_hex": "3E00",
    "note": "TesterPresent. Read-only and not gated (safety_policy.json); any reply, positive or negative, means a module is there."
  },
  "sweeps": {
    "std11": {
      "label": "11-bit 0x700-0x7F7, reply +0x08 (ISO 15765-4 convention)",
      "addressing": "normal",
      "from": "0x700",
      "to": "0x7F7",
      "rx_offset": 8
    },
    "gm11": {
      "label": "GM 11-bit 0x240-0x27F, reply +0x400",
      "addressing": "normal",
      "from": "0x240",
      "to": "0x27F",
      "rx_offset": 1024
    },
    "vag11": {
      "label": "VW group 11-bit 0x700-0x775, reply +0x6A",
      "addressing": "normal",
      "from": "0x700",
      "to": "0x775",
      "rx_offset": 106
    },
    "nissan11_20": {
      "label": "Nissan 11-bit 0x700-0x7DF, reply +0x20 (some models)",
      "addressing": "normal",
      "from": "0x700",
      "to": "0x7DF",
      "rx_offset": 32
    },
    "chrysler11": {
      "label": "Stellantis 11-bit 0x740-0x77F, reply -0x280",
      "addressing": "normal",
      "from": "0x740",
      "to": "0x77F",
      "rx_offset": -640
    },
    "iso29": {
      "label": "29-bit ISO 15765-4 normal fixed addressing, targets 0x00-0xFF",
      "addressing": "iso29",
      "from": "0x00",
      "to": "0xFF",
      "rx_offset": null
    },
    "bmw_ext": {
      "label": "BMW D-CAN extended addressing (tester 0x6F1), ECU addresses 0x00-0xFF",
      "addressing": "bmw_extended",
      "from": "0x00",
      "to": "0xFF",
      "rx_offset": null
    }
  },
