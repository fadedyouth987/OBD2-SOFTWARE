{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://obd2-diag.local/schemas/edge_ws.schema.json",
  "title": "EdgeMessage",
  "description": "Every message exchanged over the local edge WebSocket (ws://127.0.0.1:8765). Tagged union on `type`. Source of truth for the generated Rust types (typify) and Zod validators (json-schema-to-zod). Edit this file, then run `just codegen`.",
  "x-protocol-version": "1.2.0",
  "x-request-response": {
    "HelloRequest": "HelloResponse",
    "AdapterListRequest": "AdapterListResponse",
    "ConnectRequest": "AdapterStatus",
    "DisconnectRequest": "AdapterStatus",
    "SafetyConfirmRequest": "SafetyConfirmResponse",
    "DiagCommandRequest": "DiagCommandResponse",
    "LeaseStatusRequest": "LeaseStatus",
    "LeaseInstallRequest": "LeaseStatus",
    "LanStatusRequest": "LanStatus",
    "LanPairOfferRequest": "LanPairOffer",
    "LanDeviceRevokeRequest": "LanStatus",
    "LanPairRequest": "LanPairResponse"
  },
  "oneOf": [
    { "$ref": "#/definitions/HelloRequest" },
    { "$ref": "#/definitions/HelloResponse" },
    { "$ref": "#/definitions/AdapterListRequest" },
    { "$ref": "#/definitions/AdapterListResponse" },
    { "$ref": "#/definitions/ConnectRequest" },
    { "$ref": "#/definitions/DisconnectRequest" },
    { "$ref": "#/definitions/AdapterStatus" },
    { "$ref": "#/definitions/CanFrameBatch" },
    { "$ref": "#/definitions/ObdPidStream" },
    { "$ref": "#/definitions/SafetyConfirmRequest" },
    { "$ref": "#/definitions/SafetyConfirmResponse" },
    { "$ref": "#/definitions/DiagCommandRequest" },
    { "$ref": "#/definitions/DiagCommandResponse" },
    { "$ref": "#/definitions/HeuristicAlert" },
    { "$ref": "#/definitions/ErrorResponse" },
    { "$ref": "#/definitions/LeaseStatusRequest" },
    { "$ref": "#/definitions/LeaseInstallRequest" },
    { "$ref": "#/definitions/LeaseStatus" },
    { "$ref": "#/definitions/LanStatusRequest" },
    { "$ref": "#/definitions/LanStatus" },
    { "$ref": "#/definitions/LanPairOfferRequest" },
    { "$ref": "#/definitions/LanPairOffer" },
    { "$ref": "#/definitions/LanDeviceRevokeRequest" },
    { "$ref": "#/definitions/LanPairRequest" },
    { "$ref": "#/definitions/LanPairResponse" }
  ],
  "definitions": {
    "RequestId": {
      "description": "Client-generated id carried by every request and echoed by its response or error.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "SemVer": {
      "description": "Semantic version, MAJOR.MINOR.PATCH.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "HexBytes": {
      "description": "Bytes as uppercase or lowercase hex, two characters per byte, no separators.",
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2})*$"
    },
    "Rfc3339Utc": {
      "description": "RFC 3339 timestamp in UTC, e.g. 2026-11-19T06:15:58Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "TimestampUs": {
      "description": "Microseconds since the Unix epoch.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "CanId": {
      "description": "11-bit or 29-bit CAN identifier, or a K-line address.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "maximum": 536870911
    },
    "ServiceId": {
      "description": "Diagnostic service id (UDS/KWP2000 SID or OBD mode).",
      "type": "integer",
      "format": "uint8",
      "minimum": 0,
      "maximum": 255
    },
    "SafetyMode": {
      "description": "Rule 7: one spelling everywhere. Every adapter starts in SILENT.",
      "type": "string",
      "enum": ["SILENT", "ACTIVE_CONFIRMED"]
    },
    "BusProtocol": {
      "description": "Physical/link protocol for ConnectRequest. J1850 is read-only OBD through STN/ELM adapters only.",
      "type": "string",
      "enum": [
        "AUTO",
        "ISO15765_11_500",
        "ISO15765_29_500",
        "ISO15765_11_250",
        "ISO15765_29_250",
        "MS_CAN_125",
        "BMW_DCAN",
        "ISO14230_FAST",
        "ISO14230_5BAUD",
        "ISO9141_2",
        "J1850_PWM",
        "J1850_VPW"
      ]
    },
    "DiagProtocol": {
      "description": "Diagnostic application protocol. Matches the protocol keys in safety_policy.json.",
      "type": "string",
      "enum": ["UDS", "KWP2000", "OBD"]
    },
    "AdapterKind": {
      "type": "string",
      "enum": ["J2534", "SOCKETCAN", "STN_ELM", "SLCAN", "KLINE_FTDI", "VIRTUAL"]
    },
    "AdapterState": {
      "type": "string",
      "enum": ["CONNECTED", "DISCONNECTED", "ERROR"]
    },
    "LeaseTier": {
      "type": "string",
      "enum": ["COMMUNITY", "MOBILE", "PRO", "WORKSHOP", "FLEET"]
    },
    "Feature": {
      "description": "Features unlocked by the offline lease (Task 1.4). IMMO_PROGRAM is issued only on a short immobilizer lease or a diagnostic lease when the shop holds the IMMO add-on.",
      "type": "string",
      "enum": ["J2534", "UDS_ACTIVE", "CAN_RE_PRO", "IMMO_PROGRAM"]
    },
    "Severity": {
      "type": "string",
      "enum": ["INFO", "AMBER", "RED"]
    },
    "ErrorCode": {
      "description": "Every code has a one-line fix-it hint in error_hints.json (A-DX-4).",
      "type": "string",
      "enum": [
        "UNAUTHENTICATED",
        "ORIGIN_REJECTED",
        "SAFETY_BLOCKED",
        "TOKEN_INVALID",
        "PRECONDITION_UNKNOWN",
        "LEASE_REQUIRED",
        "ADAPTER_ERROR",
        "PROTOCOL_ERROR",
        "TIMEOUT",
        "VERSION_UNSUPPORTED",
        "LAN_UNAVAILABLE"
      ]
    },
    "AdapterInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "kind", "display_name", "path"],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "$ref": "#/definitions/AdapterKind" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": {
          "description": "Device path, interface name or DLL path; null for virtual adapters.",
          "type": ["string", "null"],
          "maxLength": 512
        }
      }
    },
    "CanFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp_us", "can_id", "is_extended", "dlc", "data_hex"],
      "properties": {
        "timestamp_us": { "$ref": "#/definitions/TimestampUs" },
        "can_id": { "$ref": "#/definitions/CanId" },
        "is_extended": { "type": "boolean" },
        "dlc": { "type": "integer", "format": "uint8", "minimum": 0, "maximum": 8 },
        "data_hex": { "type": "string", "pattern": "^([0-9A-Fa-f]{2}){0,8}$" }
      }
    },
    "PidSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp_us", "pid", "name", "value", "unit"],
      "properties": {
        "timestamp_us": { "$ref": "#/definitions/TimestampUs" },
        "pid": { "type": "integer", "format": "uint16", "minimum": 0, "maximum": 65535 },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "value": { "type": "number" },
        "unit": { "type": "string", "maxLength": 16 }
      }
    },
    "Preconditions": {
      "description": "Live readings the safety token was issued against. Null means the value could not be read (Rule 5: fail closed).",
      "type": "object",
      "additionalProperties": false,
      "required": ["speed_kmh", "speed_age_ms", "rpm", "battery_v"],
      "properties": {
        "speed_kmh": { "type": ["number", "null"], "minimum": 0 },
        "speed_age_ms": { "type": ["integer", "null"], "format": "uint64", "minimum": 0 },
        "rpm": { "type": ["number", "null"], "minimum": 0 },
        "battery_v": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "Nrc": {
      "description": "Negative response code from the ECU.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name"],
      "properties": {
        "code": { "type": "integer", "format": "uint8", "minimum": 0, "maximum": 255 },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "HelloRequest": {
      "description": "First message on every connection (Rule 4). Request -> HelloResponse.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "client_token", "client_version", "protocol_version", "policy_version"],
      "properties": {
        "type": { "type": "string", "enum": ["HelloRequest"] },
        "request_id": { "$ref": "#/definitions/RequestId" },
        "client_token": {
          "description": "Cloud pairing JWT (aud=edge-ws) or 6-digit local pairing code from `edge-daemon pair`. Network (phone) connections accept only the cloud pairing JWT.",
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "client_version": { "$ref": "#/definitions/SemVer" },
        "protocol_version": { "$ref": "#/definitions/SemVer" },
        "policy_version": { "$ref": "#/definitions/SemVer" }
      }
    },
    "HelloResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "session_id", "daemon_version", "protocol_version", "policy_version", "lease_tier", "features"],
      "properties": {
        "type": { "type": "string", "enum": ["HelloResponse"] },
        "request_id": { "$ref": "#/definitions/RequestId" },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "daemon_version": { "$ref": "#/definitions/SemVer" },
        "protocol_version": { "$ref": "#/definitions/SemVer" },
        "policy_version": { "$ref": "#/definitions/SemVer" },
        "lease_tier": { "$ref": "#/definitions/LeaseTier" },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/Feature" }
        }
      }
    },
    "AdapterListRequest": {
      "description": "Request -> AdapterListResponse.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id"],
      "properties": {
        "type": { "type": "string", "enum": ["AdapterListRequest"] },
        "request_id": { "$ref": "#/definitions/RequestId" }
      }
    },
    "AdapterListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "adapters"],
      "properties": {
        "type": { "type": "string", "enum": ["AdapterListResponse"] },
        "request_id": { "$ref": "#/definitions/RequestId" },
        "adapters": { "type": "array", "items": { "$ref": "#/definitions/AdapterInfo" } }
      }
    },
    "ConnectRequest": {
      "description": "Request -> AdapterStatus.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "adapter_id", "protocol", "baud_rate", "safety_mode"],
      "properties": {
        "type": { "type": "string", "enum": ["ConnectRequest"] },
        "request_id": { "$ref": "#/definitions/RequestId" },
        "adapter_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "protocol": { "$ref": "#/definitions/BusProtocol" },
        "baud_rate": {
          "description": "Bus or serial baud rate; null lets the daemon pick the protocol default.",
          "type": ["integer", "null"],
          "format": "uint32",
          "minimum": 1,
          "maximum": 4000000
        },
        "safety_mode": { "$ref": "#/definitions/SafetyMode" }
      }
    },
    "DisconnectRequest": {
      "description": "Request -> AdapterStatus.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "adapter_id"],
      "properties": {
        "type": { "type": "string", "enum": ["DisconnectRequest"] },
        "request_id": { "$ref": "#/definitions/RequestId" },
        "adapter_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "AdapterStatus": {
      "description": "Response to Connect/Disconnect, or pushed unsolicited (request_id null) when an adapter changes state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "adapter_id", "state", "battery_v"],
      "properties": {
        "type": { "type": "string", "enum": ["AdapterStatus"] },
        "request_id": {
          "anyOf": [{ "$ref": "#/definitions/RequestId" }, { "type": "null" }]
        },
        "adapter_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "state": { "$ref": "#/definitions/AdapterState" },
        "battery_v": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "CanFrameBatch": {
      "description": "Pushed by the daemon.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "frames"],
      "properties": {
        "type": { "type": "string", "enum": ["CanFrameBatch"] },
        "frames": { "type": "array", "items": { "$ref": "#/definitions/CanFrame" } }
      }
    },
    "ObdPidStream": {
      "description": "Pushed by the daemon.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "samples"],
      "properties": {
        "type": { "type": "string", "enum": ["ObdPidStream"] },
        "samples": { "type": "array", "items": { "$ref": "#/definitions/PidSample" } }
      }
    },
    "SafetyConfirmRequest": {
      "description": "Asks for a single-use safety token for one gated request. Request -> SafetyConfirmResponse.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "tx_id", "rx_id", "protocol", "service_id", "payload_hex", "user_ack_text"],
      "properties": {
        "type": { "type": "string", "enum": ["SafetyConfirmRequest"] },
        "request_id": { "$ref": "#/definitions/RequestId" },
        "tx_id": { "$ref": "#/definitions/CanId" },
        "rx_id": { "$ref": "#/definitions/CanId" },
        "protocol": { "$ref": "#/definitions/DiagProtocol" },
        "service_id": { "$ref": "#/definitions/ServiceId" },
        "payload_hex": { "$ref": "#/definitions/HexBytes" },
        "user_ack_text": {
          "description": "The confirmation text the technician acknowledged (names action, ECU and consequence).",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "SafetyConfirmResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "safety_token", "expires_at", "preconditions"],
      "properties": {
        "type": { "type": "string", "enum": ["SafetyConfirmResponse"] },
        "request_id": { "$ref": "#/definitions/RequestId" },
        "safety_token": { "type": "string", "minLength": 16, "maxLength": 256 },
        "expires_at": { "$ref": "#/definitions/Rfc3339Utc" },
        "preconditions": { "$ref": "#/definitions/Preconditions" }
      }
    },
    "DiagCommandRequest": {
      "description": "Request -> DiagCommandResponse. Gated services need safety_token (see safety_policy.json).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "tx_id", "rx_id", "protocol", "service_id", "payload_hex", "safety_token"],
      "properties": {
        "type": { "type": "string", "enum": ["DiagCommandRequest"] },
        "request_id": { "$ref": "#/definitions/RequestId" },
        "tx_id": { "$ref": "#/definitions/CanId" },
        "rx_id": { "$ref": "#/definitions/CanId" },
        "protocol": { "$ref": "#/definitions/DiagProtocol" },
        "service_id": { "$ref": "#/definitions/ServiceId" },
        "payload_hex": { "$ref": "#/definitions/HexBytes" },
        "safety_token": { "type": ["string", "null"], "minLength": 16, "maxLength": 256 }
      }
    },
    "DiagCommandResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "positive", "response_hex", "nrc"],
      "properties": {
        "type": { "type": "string", "enum": ["DiagCommandResponse"] },
        "request_id": { "$ref": "#/definitions/RequestId" },
        "positive": { "type": "boolean" },
        "response_hex": { "$ref": "#/definitions/HexBytes" },
        "nrc": {
          "anyOf": [{ "$ref": "#/definitions/Nrc" }, { "type": "null" }]
        }
      }
    },
    "HeuristicAlert": {
      "description": "Pushed by the daemon.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rule_id", "severity", "title", "evidence_json", "recommended_test"],
      "properties": {
        "type": { "type": "string", "enum": ["HeuristicAlert"] },
        "rule_id": { "type": "string", "pattern": "^[a-z0-9_.-]{1,64}$" },
        "severity": { "$ref": "#/definitions/Severity" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evidence_json": {
          "description": "Rule-specific evidence as a JSON object.",
          "type": "object"
        },
        "recommended_test": { "type": "string", "maxLength": 1000 }
      }
    },
    "ErrorResponse": {
      "description": "Any request can fail with this. request_id is null when the failed message could not be parsed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "code", "message", "hint", "detail_json"],
      "properties": {
        "type": { "type": "string", "enum": ["ErrorResponse"] },
        "request_id": {
          "anyOf": [{ "$ref": "#/definitions/RequestId" }, { "type": "null" }]
        },
        "code": { "$ref": "#/definitions/ErrorCode" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "hint": {
          "description": "One line of fix-it text (A-DX-4); defaults come from error_hints.json.",
          "type": "string",
          "pattern": "^[^\\r\\n]{1,200}$"
        },
        "detail_json": {
          "anyOf": [{ "type": "object" }, { "type": "null" }]
        }
      }
    },
    "LeaseKind": {
      "description": "Which lease a LeaseInstallRequest carries: the offline diagnostic lease (lease.jwt) or a short immobilizer lease (immo_lease.jwt).",
      "type": "string",
      "enum": ["DIAGNOSTIC", "IMMO"]
    },
    "LeaseStatusRequest": {
      "description": "Request -> LeaseStatus.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id"],
      "properties": {
        "type": { "type": "string", "enum": ["LeaseStatusRequest"] },
        "request_id": { "$ref": "#/definitions/RequestId" }
      }
    },
    "LeaseInstallRequest": {
      "description": "Installs a cloud-signed lease (POST /auth/edge-lease, or an immobilizer job token). The daemon verifies it against the pinned cloud keys before saving it. Request -> LeaseStatus.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "kind", "lease_token"],
      "properties": {
        "type": { "type": "string", "enum": ["LeaseInstallRequest"] },
        "request_id": { "$ref": "#/definitions/RequestId" },
        "kind": { "$ref": "#/definitions/LeaseKind" },
        "lease_token": {
          "description": "Compact JWS signed by the cloud API.",
          "type": "string",
          "minLength": 16,
          "maxLength": 8192
        }
      }
    },
    "LeaseStatus": {
      "description": "The lease this connection runs under. Response to LeaseStatusRequest and LeaseInstallRequest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request_id",
        "lease_tier",
        "features",
        "expires_at",
        "immo_expires_at",
        "cloud_keys_pinned"
      ],
      "properties": {
        "type": { "type": "string", "enum": ["LeaseStatus"] },
        "request_id": { "$ref": "#/definitions/RequestId" },
        "lease_tier": { "$ref": "#/definitions/LeaseTier" },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/Feature" }
        },
        "expires_at": {
          "description": "When the offline lease ends; null on the built-in COMMUNITY tier.",
          "anyOf": [{ "$ref": "#/definitions/Rfc3339Utc" }, { "type": "null" }]
        },
        "immo_expires_at": {
          "description": "When the installed immobilizer lease ends; null when there is none.",
          "anyOf": [{ "$ref": "#/definitions/Rfc3339Utc" }, { "type": "null" }]
        },
        "cloud_keys_pinned": {
          "description": "False when no cloud signing key is pinned, so cloud leases and pairing tokens cannot verify (COMMUNITY tier, local pairing codes only).",
          "type": "boolean"
        }
      }
    },
    "LanDevice": {
      "description": "A phone paired for network access (LanStatus.devices).",
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "name", "paired_at", "last_seen_at", "paired_by", "connected"],
      "properties": {
        "device_id": { "description": "Id of a paired phone.", "type": "string", "pattern": "^lan_[0-9a-f]{16}$" },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "description": "Name the phone gave when it paired."
        },
        "paired_at": { "$ref": "#/definitions/Rfc3339Utc" },
        "last_seen_at": {
          "anyOf": [{"$ref": "#/definitions/Rfc3339Utc"}, {"type": "null"}],
          "description": "Last connection; null if it never connected after pairing."
        },
        "paired_by": {
          "description": "Cloud user id of the technician who created the pairing code; null when it came from `edge-daemon lan pair`.",
          "type": ["string", "null"],
          "maxLength": 64
        },
        "connected": { "description": "True while the phone has a connection open.", "type": "boolean" }
      }
    },
    "LanStatusRequest": {
      "description": "Phone access over the local network: settings and paired phones. Loopback connections only. Request -> LanStatus.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id"],
      "properties": {
        "type": { "type": "string", "enum": ["LanStatusRequest"]},
        "request_id": { "$ref": "#/definitions/RequestId" }
      }
    },
    "LanStatus": {
      "description": "Response to LanStatusRequest and LanDeviceRevokeRequest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request_id",
        "enabled",
        "port",
        "addresses",
        "fingerprint",
        "daemon_id",
        "daemon_name",
        "mdns",
        "devices"
      ],
      "properties": {
        "type": { "type": "string", "enum": ["LanStatus"]},
        "request_id": { "$ref": "#/definitions/RequestId" },
        "enabled": {
          "description": "True when the network listener is on (it is off until `edge-daemon lan enable`).",
          "type": "boolean"
        },
        "port": {
          "description": "TLS port phones connect to.",
          "type": "integer",
          "format": "uint16",
          "minimum": 1,
          "maximum": 65535
        },
        "addresses": {
          "description": "This PC's addresses a phone could use, best first; empty when off.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "description": "IP address of this PC on the workshop network (IPv4 dotted, or IPv6 without brackets).",
            "type": "string",
            "minLength": 2,
            "maxLength": 45,
            "pattern": "^[0-9A-Fa-f:.]+$"
          }
        },
        "fingerprint": {
          "anyOf": [
            {
              "description": "SHA-256 of the daemon's network TLS certificate (DER), lowercase hex. The phone pins it.",
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            { "type": "null" }
          ],
          "description": "Certificate fingerprint; null when off."
        },
        "daemon_id": {
          "anyOf": [
            {
              "description": "Stable id of this daemon, in the pairing QR code and mDNS record.",
              "type": "string",
              "pattern": "^rcd_[0-9a-f]{16}$"
            },
            { "type": "null" }
          ],
          "description": "Null when off."
        },
        "daemon_name": { "type": "string", "minLength": 1, "maxLength": 48, "description": "Name phones show for this PC." },
        "mdns": { "description": "True when the PC advertises itself on mDNS.", "type": "boolean" },
        "devices": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/LanDevice" }}
      }
    },
    "LanPairOfferRequest": {
      "description": "Creates a one-time pairing QR code for a phone (5 minutes, single use). Loopback connections only. Request -> LanPairOffer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "host"],
      "properties": {
        "type": { "type": "string", "enum": ["LanPairOfferRequest"]},
        "request_id": { "$ref": "#/definitions/RequestId" },
        "host": {
          "anyOf": [
            {
              "description": "IP address of this PC on the workshop network (IPv4 dotted, or IPv6 without brackets).",
              "type": "string",
              "minLength": 2,
              "maxLength": 45,
              "pattern": "^[0-9A-Fa-f:.]+$"
            },
            { "type": "null" }
          ],
          "description": "Which of LanStatus.addresses to put in the code; null picks the best."
        }
      }
    },
    "LanPairOffer": {
      "description": "A pairing code for a phone. Response to LanPairOfferRequest.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "pairing_uri", "host", "port", "fingerprint", "expires_at", "qr_rows"],
      "properties": {
        "type": { "type": "string", "enum": ["LanPairOffer"]},
        "request_id": { "$ref": "#/definitions/RequestId" },
        "pairing_uri": {
          "description": "rootcause://lan-pair link with host, port, fingerprint, one-time token, daemon id and name. Shown as a QR code; it is a secret until used or expired.",
          "type": "string",
          "minLength": 16,
          "maxLength": 512,
          "pattern": "^rootcause://lan-pair\\?"
        },
        "host": {
          "description": "IP address of this PC on the workshop network (IPv4 dotted, or IPv6 without brackets).",
          "type": "string",
          "minLength": 2,
          "maxLength": 45,
          "pattern": "^[0-9A-Fa-f:.]+$"
        },
        "port": { "type": "integer", "format": "uint16", "minimum": 1, "maximum": 65535},
        "fingerprint": {
          "description": "SHA-256 of the daemon's network TLS certificate (DER), lowercase hex. The phone pins it.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at": { "$ref": "#/definitions/Rfc3339Utc" },
        "qr_rows": {
          "description": "The QR code: one string per row, '1' dark and '0' light, no quiet zone.",
          "type": "array",
          "minItems": 21,
          "maxItems": 177,
          "items": { "type": "string", "minLength": 21, "maxLength": 177, "pattern": "^[01]+$" }
        }
      }
    },
    "LanDeviceRevokeRequest": {
      "description": "Removes a paired phone and closes its connections. Loopback connections only. Request -> LanStatus.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "device_id"],
      "properties": {
        "type": { "type": "string", "enum": ["LanDeviceRevokeRequest"]},
        "request_id": { "$ref": "#/definitions/RequestId" },
        "device_id": { "description": "Id of a paired phone.", "type": "string", "pattern": "^lan_[0-9a-f]{16}$" }
      }
    },
    "LanPairRequest": {
      "description": "First and only message on a network pairing connection (Authorization: RootCause-Pair <token>). Request -> LanPairResponse.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "device_name", "client_version"],
      "properties": {
        "type": { "type": "string", "enum": ["LanPairRequest"]},
        "request_id": { "$ref": "#/definitions/RequestId" },
        "device_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "description": "Shown on the PC, e.g. the phone model."
        },
        "client_version": { "$ref": "#/definitions/SemVer" }
      }
    },
    "LanPairResponse": {
      "description": "The phone's credential for later connections (Authorization: Bearer <device_id>.<device_secret>). Sent once; the daemon keeps only its hash. Response to LanPairRequest.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "request_id", "device_id", "device_secret", "daemon_id", "daemon_name"],
      "properties": {
        "type": { "type": "string", "enum": ["LanPairResponse"]},
        "request_id": { "$ref": "#/definitions/RequestId" },
        "device_id": { "description": "Id of a paired phone.", "type": "string", "pattern": "^lan_[0-9a-f]{16}$" },
        "device_secret": {
          "description": "32 random bytes, base64url without padding.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "daemon_id": {
          "description": "Stable id of this daemon, in the pairing QR code and mDNS record.",
          "type": "string",
          "pattern": "^rcd_[0-9a-f]{16}$"
        },
        "daemon_name": { "type": "string", "minLength": 1, "maxLength": 48}
      }
    }
  }
}
